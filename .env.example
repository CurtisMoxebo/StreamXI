# ==========================================
# StreamXI Global Configuration (.env)
# Shared across Backend, Frontend, and Docker
# ==========================================

# Server & Environment
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=3000
PORT=5000
DOMAIN=streamxi.moxebocurtis.com

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Xtream Codes IPTV Credentials
XTREAM_URL=http://iptv.example.com:8080
XTREAM_USERNAME=your_xtream_username
XTREAM_PASSWORD=your_xtream_password

# Public URL for Frontend
VITE_API_URL=http://localhost:5000/api
